{
  "name": "@jiro/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:migrate": "wrangler d1 migrations apply jiro-db --remote && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply jiro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jiro-db --remote",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@jiro/core": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
