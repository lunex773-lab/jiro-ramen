// 次郎系ラーメン経営ゲームのバックエンド（Cloudflare Workers + Durable Objects + D1。R2 は使わない: docs/adr/ADR-002-no-r2.md）。
// 設計書 2.2 / 17 / 18 に対応。デプロイ手順は docs/CLOUDFLARE_SETUP.md を参照。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker の名前。GitHub Actions（.github/workflows/deploy-server.yml）がこの名前でデプロイし、
  // ブラウザ版のビルド（pages.yml）はこの名前から URL（https://jiro-ramen.<サブドメイン>.workers.dev）を求める
  "name": "jiro-ramen",
  "main": "src/index.ts",
  // テストで使う vitest-pool-workers 同梱の workerd（1.20260815）でも動く日付にしている。
  // 日付を上げるときは apps/server と ルートの node_modules にある workerd の両方が対応しているか確認すること。
  "compatibility_date": "2026-08-01",
  // Node.js API は使っていないので nodejs_compat は不要。
  "compatibility_flags": [],

  // Workers Logs（wrangler tail / ダッシュボードのログ）を有効にする
  "observability": { "enabled": true },

  // 共同経営ルーム。1ルーム = 1 Durable Object（ルームIDから idFromName で決まる。設計書 2.2）
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // SQLite ストレージを使う Durable Object として登録する（無料プランでも使える方式）
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jiro-db",
      // この値のままにしておく。GitHub Actions のデプロイが、アカウントの jiro-db（なければ作る）の ID に実行時だけ置き換える
      //   （apps/server/scripts/cloudflare.mjs。リポジトリには書き戻さない）。
      //   パソコンから手でデプロイするときだけ、D1 の画面の Database ID（8-4-4-4-12 の形式）に置き換える。
      //   テーブルは Worker が自分で作る（src/schema.ts）。ローカル開発・テスト（--local / vitest）はこのままの値で動く。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "GAME_VERSION": "0.9.0",
    // これより古いクライアントは WebSocket の hello で拒否する
    "MIN_CLIENT_VERSION": "0.1.0",
    // CORS を許可するオリジン（カンマ区切り）。GitHub Pages とローカルの Vite 開発サーバー
    "ALLOWED_ORIGINS": "https://lunex773-lab.github.io,http://localhost:5173"
  }
  // 秘密情報（SESSION_SECRET: 参加トークンの HMAC 鍵）は vars に書かない。
  //   本番: GitHub Actions のデプロイが、未登録ならランダムな値を作って登録する（手でデプロイするなら `npx wrangler secret put SESSION_SECRET`）
  //   ローカル: apps/server/.dev.vars（.dev.vars.example をコピー）
}
